# ---- HTTP ----
PORT=3000
# Interface to listen on. 127.0.0.1 = this machine only (default). Use 0.0.0.0 to serve other machines.
HOST=127.0.0.1
# Comma-separated origins, only needed when the frontend is on another origin.
CORS_ORIGIN=
# Folder of the built frontend (npm run build in ../frontend). Served at "/" when it exists.
FRONTEND_DIST=../frontend/dist
# Set to 1 behind one reverse proxy / Cloudflare so audit logs and rate limits see the real client IP.
TRUST_PROXY=

# ---- App database: users, branch IP list, audit log ----
MONGO_URI=mongodb://127.0.0.1:27017/csms2

# ---- Auth ----
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=8h
# Users created on first boot when missing (comma-separated, all get SEED_PASSWORD).
SEED_USERNAMES=ease
SEED_PASSWORD=change-me

# ---- Clinic (branch) servers: DreaseV2 MongoDB ----
# {ip} is replaced with the IP chosen in the UI. Add credentials if the branch servers need them:
# CLINIC_MONGO_URI_TEMPLATE=mongodb://user:password@{ip}:27017/?authSource=admin
CLINIC_MONGO_URI_TEMPLATE=mongodb://{ip}:27017
# DreaseV2 database name on the branch servers (local DreaseV2 dumps use "mris").
# Use csms2_demo_clinic with `npm run seed:demo` for local testing.
CLINIC_DB_NAME=mris
CLINIC_CONNECT_TIMEOUT_MS=5000

# ---- "↻ โหลดรายการใหม่จาก Google Sheet" ----
# Google Sheet CSV export link, e.g. https://docs.google.com/spreadsheets/d/<id>/export?format=csv&gid=<gid>
# A JSON URL returning {"list":[{"ip","label"}]} also works.
IP_LIST_SOURCE_URL=
